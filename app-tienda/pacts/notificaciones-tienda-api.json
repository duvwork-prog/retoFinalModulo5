{
  "consumer": {
    "name": "notificaciones"
  },
  "provider": {
    "name": "tienda-api"
  },
  "interactions": [
    {
      "description": "una petición para consultar el producto 1",
      "request": {
        "method": "get",
        "path": "/api/productos/1"
      },
      "response": {
        "status": 200,
        "headers": {
        },
        "body": {
          "id": 1,
          "nombre": "Silla ergonómica",
          "categoria": "hogar",
          "precio": 99.99,
          "stock": 10
        },
        "matchingRules": {
          "$.body.id": {
            "match": "type"
          },
          "$.body.nombre": {
            "match": "type"
          },
          "$.body.categoria": {
            "match": "type"
          },
          "$.body.precio": {
            "match": "type"
          },
          "$.body.stock": {
            "match": "type"
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "2.0.0"
    }
  }
}