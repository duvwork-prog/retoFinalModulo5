{
  "name": "datos",
  "version": "1.0.0",
  "description": "Ejercicios Dia 1 - Certificacion 5 QA Cloud-Native: generacion de datos sinteticos, anonimizacion GDPR y versionado para ejecucion paralela",
  "type": "module",
  "scripts": {
    "inspeccionar": "node 1-mockaroo/inspeccionar-mockaroo.js",
    "generar": "node 2-faker/generar-datos.js",
    "catalogo": "node 2-faker/generar-datos.js",
    "build": "node scripts/build-check.js",
    "smoke": "node scripts/smoke-tests.js",
    "load": "node scripts/load-test.js",
    "load:green": "node -e \"process.env.SLA_P95_MS='800'; process.env.SLA_ERROR_RATE='0.01'; import('./scripts/load-test.js');\"",
    "load:red": "node -e \"process.env.SLA_P95_MS='1'; process.env.SLA_ERROR_RATE='0.01'; import('./scripts/load-test.js');\"",
    "dump-real": "node 3-anomizar/1-generar-dump-real.js",
    "anonimizar": "node 3-anomizar/2-anonimizar.js",
    "seed": "node seed/seed.js seed",
    "restaurar": "node seed/seed.js restaurar",
    "paralelo": "node seed/seed.js paralelo",
    "api": "json-server data/usuarios.json --port 3000",
    "todo": "npm run generar && npm run dump-real && npm run anonimizar && npm run seed"
  },
  "keywords": [
    "qa",
    "testing",
    "faker",
    "datos",
    "gdpr",
    "cloud-native"
  ],
  "author": "Lite Thinking University of Technology",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "devDependencies": {
    "json-server": "0.17.4"
  }
}
